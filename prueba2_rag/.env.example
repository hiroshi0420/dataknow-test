
# Copia este archivo como .env y llena los valores

# Ruta al Excel (en caso de apuntar a otra ruta)
# DATA_PATH=Datos/sentencias_pasadas.xlsx

# Modo de embeddings:
#   - local  : intenta sentence-transformers; si no está disponible usa TF-IDF (offline)
#   - azure  : Azure OpenAI embeddings (recomendado)
EMBEDDING_MODE=local

# Modo de LLM:
#   - azure      : Azure OpenAI Chat (recomendado) 
#   - local      : Ollama local (sin API)
#   - extractive : sin LLM (fallback para probar que el pipeline corre)
LLM_MODE=extractive

# Azure OpenAI (solo si usas modo azure) 
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=TU-API-KEY-AQUI
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-ada-002

# Modo local con Ollama (solo si LLM_MODE=local)
# OLLAMA_MODEL=mistral
